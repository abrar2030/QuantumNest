# Copy this file to .env and fill in your values, then run:
#   docker compose up -d
# Never commit the real .env to version control.

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false

# ── Ports (host side) ────────────────────────────────────────────────────────
BACKEND_PORT=8000
WEB_FRONTEND_PORT=3000
MOBILE_FRONTEND_PORT=3001

# ── Frontend → Backend wiring ────────────────────────────────────────────────
# Must be reachable from the end user's browser (baked into the client bundle
# at build time). Defaults to the backend port published above.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quantumnest

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_use_python_secrets_token_hex_32
API_SECRET_KEY=CHANGE_ME_use_python_secrets_token_hex_32

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── API Keys (all optional) ──────────────────────────────────────────────────
OPENAI_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ── Blockchain (optional) ────────────────────────────────────────────────────
# Only needed if you run a separate Ethereum node (e.g. Hardhat) and want the
# /blockchain endpoints to reach it. Defaults to the backend's own built-in
# default (http://localhost:8545) if left unset.
ETHEREUM_RPC_URL=

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=
PROMETHEUS_ENABLED=false

# ── Workers ───────────────────────────────────────────────────────────────────
WORKERS=2
