# Copy this file to .env and fill in your values, then run:
#   docker compose up -d
# Never commit the real .env to version control.

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false

# ── Ports (host side) ────────────────────────────────────────────────────────
BACKEND_PORT=8000
WEB_FRONTEND_PORT=3000
MOBILE_FRONTEND_PORT=3001

# ── Frontend → Backend wiring ────────────────────────────────────────────────
# Must be reachable from the end user's browser (baked into the client bundle
# at build time). Defaults to the backend port published above.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quantumnest

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_use_python_secrets_token_hex_32
API_SECRET_KEY=CHANGE_ME_use_python_secrets_token_hex_32

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── API Keys (all optional) ──────────────────────────────────────────────────
OPENAI_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ── Blockchain (optional) ────────────────────────────────────────────────────
# `docker compose up` runs a local Hardhat node (the `blockchain` service)
# automatically, so the defaults below work out of the box for local dev.
# Override ETHEREUM_RPC_URL to point at a real testnet/mainnet RPC provider
# instead (e.g. Infura) for anything beyond local development.
#
# Contracts aren't auto-deployed to the local node on every boot (its state
# is ephemeral - re-deploying on every restart would hand out new addresses
# each time). Deploy them once with:
#   docker compose --profile blockchain-deploy run --rm blockchain-deploy
# See blockchain/deployments/README.md for what that writes and how the
# backend picks it up.
ETHEREUM_RPC_URL=
# Which network's deployment the backend reads contract addresses/ABIs
# from - should match blockchain-deploy above (its hardhat.config.js
# `docker` network writes deployments/docker.json).
BLOCKCHAIN_NETWORK=docker
# A funded account's private key, only needed for endpoints that send
# transactions (contract deployment, state-changing calls). Read-only
# endpoints (balances, contract reads) work without it. Leave unset for a
# read-only setup, or use one of the local Hardhat node's well-known
# pre-funded test accounts for local dev only - never a real funded key.
BLOCKCHAIN_PRIVATE_KEY=

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=
PROMETHEUS_ENABLED=false

# ── Workers ───────────────────────────────────────────────────────────────────
WORKERS=2
