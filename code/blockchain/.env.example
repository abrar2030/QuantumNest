# Blockchain environment configuration
# Copy to .env and fill in real values — never commit .env to git

# ── RPC Provider ──────────────────────────────────────────────────────────────
# Local Hardhat node (used by docker-compose)
ETHEREUM_RPC_URL=http://localhost:8545

# Infura (for testnet / mainnet deployments)
INFURA_API_KEY=
INFURA_SEPOLIA_URL=https://sepolia.infura.io/v3/${INFURA_API_KEY}
INFURA_MAINNET_URL=https://mainnet.infura.io/v3/${INFURA_API_KEY}

# ── Deployer Wallet ───────────────────────────────────────────────────────────
# Use a dedicated deployment wallet — NEVER use a wallet holding real funds
# for development/testing
PRIVATE_KEY=

# ── Contract Verification (Etherscan) ────────────────────────────────────────
ETHERSCAN_API_KEY=

# ── Network ───────────────────────────────────────────────────────────────────
# NOTE: Goerli and Mumbai were deprecated; Sepolia and Polygon Amoy are their
# official replacements (see hardhat.config.js).
NETWORK=hardhat     # hardhat | sepolia | polygon_amoy | mainnet
CHAIN_ID=31337      # 31337=hardhat | 11155111=sepolia | 80002=amoy | 1=mainnet
